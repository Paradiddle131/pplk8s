        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (dag_id, le) (rate(airflow_task_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{dag_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (dag_id, le) (rate(airflow_task_duration_seconds_bucket[$__rate_interval])))",
